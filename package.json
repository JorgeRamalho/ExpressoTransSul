{
  "name": "projeto-expressotranssul",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.js",
    "dev:full": "concurrently -k -n api,vite -c green,blue \"npm run api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:watch": "vite build --watch",
    "live:serve": "live-server dist --port=5500 --host=127.0.0.1 --open=/ --entry-file=index.html",
    "live": "vite build && live-server dist --port=5500 --host=127.0.0.1 --open=/ --entry-file=index.html",
    "live:watch": "vite build && concurrently -k -n build,server -c blue,green \"vite build --watch\" \"live-server dist --port=5500 --host=127.0.0.1 --open=/ --entry-file=index.html\"",
    "live:full": "concurrently -k -n api,build,server -c green,blue,magenta \"npm run api\" \"vite build --watch\" \"live-server dist --port=5500 --host=127.0.0.1 --open=/ --entry-file=index.html\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "live-server": "^1.2.2",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
